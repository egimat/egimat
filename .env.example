# Anthropic API key for classification engine
ANTHROPIC_API_KEY=your-api-key-here

# Google Drive credentials (if using Drive integration)
# GOOGLE_CREDENTIALS_PATH=./credentials.json

# Automation mode override (optional, defaults to taxonomy global_settings)
# AUTOMATION_MODE=suggest_only

# Database path (optional, defaults to ./data/organizer.db)
# DATABASE_PATH=./data/organizer.db
